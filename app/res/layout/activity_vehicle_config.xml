<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_text" />

        <EditText android:id="@+id/nickname" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="Nickname, e.g. My LYRIQ" android:inputType="textCapWords" android:importantForAutofill="no" />

        <!-- Live status card mirrors what the widget shows -->
        <LinearLayout
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/status_gauge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="34sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_text"
                    android:text="—" />

                <TextView
                    android:id="@+id/status_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/widget_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Refresh now" />

        <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Widget style" />

        <RadioGroup
            android:id="@+id/style_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/style_car" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Car — your LYRIQ in its paint color with a battery bar (default)" />
            <RadioButton android:id="@+id/style_ring" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ring — charge ring with percent and range" />
            <RadioButton android:id="@+id/style_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bar — big percent over a slim battery bar" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/section_car_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="LYRIQ paint" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/color_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </HorizontalScrollView>

            <TextView android:id="@+id/color_name" style="@style/Hint" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/car_color_hex" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Custom hex, e.g. #1C3D72" android:inputType="textNoSuggestions" android:importantForAutofill="no" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Data source" />

        <RadioGroup
            android:id="@+id/source_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/source_smartcar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Smartcar (official OnStar-backed API)" />
            <RadioButton android:id="@+id/source_ha" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Home Assistant (onstar2mqtt / any entity)" />
        </RadioGroup>

        <!-- Smartcar -->
        <LinearLayout
            android:id="@+id/section_smartcar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="From dashboard.smartcar.com: paste the Application ID (Application details tab), the client_… Client ID and the Client secret (API credentials tab), then add the redirect URI shown below under Redirect URIs before connecting." />

            <EditText android:id="@+id/sc_client_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Application ID (UUID, Application details tab)" android:inputType="textNoSuggestions" android:importantForAutofill="no" />
            <EditText android:id="@+id/sc_token_client_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Client ID (client_…, API credentials tab)" android:inputType="textNoSuggestions" android:importantForAutofill="no" />
            <EditText android:id="@+id/sc_client_secret" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Client secret (API credentials tab)" android:inputType="textPassword" android:importantForAutofill="no" />

            <TextView android:id="@+id/sc_redirect_uri" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textIsSelectable="true" android:textSize="13sp" android:fontFamily="monospace" android:textColor="@color/widget_text" android:paddingTop="6dp" android:paddingBottom="6dp" />

            <CheckBox android:id="@+id/sc_simulated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Use a Smartcar simulated vehicle (test mode)" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btn_sc_connect" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Connect vehicle" />
                <Button android:id="@+id/btn_sc_disconnect" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Disconnect" />
            </LinearLayout>

            <TextView android:id="@+id/sc_status" style="@style/Hint" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Home Assistant -->
        <LinearLayout
            android:id="@+id/section_ha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Reads entity states from Home Assistant's REST API. Works with onstar2mqtt (sensor.NAME_ev_battery_level etc.) or any integration." />

            <EditText android:id="@+id/ha_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Base URL, e.g. https://ha.example.com or http://homeassistant.local:8123" android:inputType="textUri" android:importantForAutofill="no" />
            <EditText android:id="@+id/ha_token" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Long-lived access token" android:inputType="textPassword" android:importantForAutofill="no" />
            <EditText android:id="@+id/ha_entity_battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Battery % entity (sensor.lyriq_ev_battery_level)" android:inputType="textNoSuggestions" android:importantForAutofill="no" />
            <EditText android:id="@+id/ha_entity_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Range entity, optional (sensor.lyriq_ev_range)" android:inputType="textNoSuggestions" android:importantForAutofill="no" />
            <EditText android:id="@+id/ha_entity_charging" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Charging entity, optional (binary_sensor / sensor)" android:inputType="textNoSuggestions" android:importantForAutofill="no" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh" />
        <TextView style="@style/Hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Background refresh interval in minutes (minimum 15). Smartcar's free plan allows 500 calls per vehicle per month, so keep it at 120 or more there; tapping the widget always refreshes immediately." />
        <EditText android:id="@+id/refresh_minutes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Minutes" android:inputType="number" android:importantForAutofill="no" />

        <Button android:id="@+id/btn_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Save" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" style="@style/Hint"
            android:text="Credentials are stored only on this phone in the app's private storage." />
    </LinearLayout>
</ScrollView>
